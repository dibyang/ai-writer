  "chapter_functions": [
    {
      "unit": 1,
      "goal": {
        "status": "observed",
        "text": "目标：沈禾要取借具、还店又送备货单，时间和误传话挤在一起。",
        "evidence": [
          {
            "unit": 1,
            "draft": "正文/0001-灯下的箱子-v2.md",
            "sha256": "6b7dda66e606b753b75cbebeab8af536b797b0060a9c14048932da58a6709893",
            "line": 74,
            "quote": "我还得回店里送张单子。"
          }
        ]
      },
      "obstacle": {
        "status": "unknown",
        "reason": "本章多线的具体阻力与限制见本章因果/连续性笔记；本表没有为其另补一个独立统一阻碍或新增原文证据。目标：沈禾要取借具、还店又送备货单，时间和误传话挤在一起。"
      },
      "choice": {
        "status": "observed",
        "text": "选择：周岸不接“应该”退押金，先核通话；沈禾先拍单、再托有条件顺送。",
        "evidence": [
          {
            "unit": 1,
            "draft": "正文/0001-灯下的箱子-v2.md",
            "sha256": "6b7dda66e606b753b75cbebeab8af536b797b0060a9c14048932da58a6709893",
            "line": 272,
            "quote": "没去成，再还你。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "后果：八十押金仅父亲说仍押着，梁伯未核；箱未开未交，三人等到9:10。",
        "evidence": [
          {
            "unit": 1,
            "draft": "正文/0001-灯下的箱子-v2.md",
            "sha256": "6b7dda66e606b753b75cbebeab8af536b797b0060a9c14048932da58a6709893",
            "line": 278,
            "quote": "那就等到九点十分。"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "关系：沈禾在意父亲不是遗失者，许蓉不纠缠责任、改以接续安排安顿。",
        "evidence": [
          {
            "unit": 1,
            "draft": "正文/0001-灯下的箱子-v2.md",
            "sha256": "6b7dda66e606b753b75cbebeab8af536b797b0060a9c14048932da58a6709893",
            "line": 207,
            "quote": "我记下，等人接上就好找。"
          }
        ]
      }
    },
    {
      "unit": 2,
      "goal": {
        "status": "observed",
        "text": "目标：完成可追踪的收箱退押、替沈禾省跑店的一趟。",
        "evidence": [
          {
            "unit": 2,
            "draft": "正文/0002-多跑的一趟-v2.md",
            "sha256": "78ff1a743694ce4ca1fb0dcca7a7d94dab5f36b7305d2ba078522f408653d886",
            "line": 29,
            "quote": "周岸，你回来照清单收。"
          }
        ]
      },
      "obstacle": {
        "status": "unknown",
        "reason": "本章多线的具体阻力与限制见本章因果/连续性笔记；本表没有为其另补一个独立统一阻碍或新增原文证据。目标：完成可追踪的收箱退押、替沈禾省跑店的一趟。"
      },
      "choice": {
        "status": "observed",
        "text": "选择：梁伯明确委托周岸码头验收，要求拿原钱袋而非自垫；许蓉收回借拉车的默认安排。",
        "evidence": [
          {
            "unit": 2,
            "draft": "正文/0002-多跑的一趟-v2.md",
            "sha256": "78ff1a743694ce4ca1fb0dcca7a7d94dab5f36b7305d2ba078522f408653d886",
            "line": 43,
            "quote": "你别拿自己的先垫，去拿那个袋子"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "后果：备货原单已交，姑娘可直回家；钱仍在铺、箱未开、待9:40。",
        "evidence": [
          {
            "unit": 2,
            "draft": "正文/0002-多跑的一趟-v2.md",
            "sha256": "78ff1a743694ce4ca1fb0dcca7a7d94dab5f36b7305d2ba078522f408653d886",
            "line": 123,
            "quote": "原单收到 周师傅送的 明早按新的做 你别再跑店里了"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "关系：沈禾说家中用车不可借，许接受；姑娘开始主动协助贴告示、移椅，父亲接受在家等。",
        "evidence": [
          {
            "unit": 2,
            "draft": "正文/0002-多跑的一趟-v2.md",
            "sha256": "78ff1a743694ce4ca1fb0dcca7a7d94dab5f36b7305d2ba078522f408653d886",
            "line": 115,
            "quote": "家里买米用。这个不能借"
          }
        ]
      }
    },
    {
      "unit": 3,
      "goal": {
        "status": "observed",
        "text": "目标：周岸带凭据和原钱回来，清点后实际接箱退押。",
        "evidence": [
          {
            "unit": 3,
            "draft": "正文/0003-把手朝外-final-b.md",
            "sha256": "8439948a84b45466fc68a961df8ecda64d3d976b9c95076096946eccab5bc511",
            "line": 49,
            "quote": "你帮我念，念一个拿一个。"
          }
        ]
      },
      "obstacle": {
        "status": "unknown",
        "reason": "本章多线的具体阻力与限制见本章因果/连续性笔记；本表没有为其另补一个独立统一阻碍或新增原文证据。周要按委托收箱退押，‘你帮我念，念一个拿一个’使八件逐件出入；见锤缝选择‘我先问一句’，梁确认旧缝才准退，后果‘八十全退’真交沈。父问吃没/女说‘梁伯说他换’转回两人饭桌，父主动拉椅留宽，关系从代父担责转成可共同吃咸黄瓜。"
      },
      "choice": {
        "status": "observed",
        "text": "选择：发现锤柄浅缝不私断责任，发图给梁伯核原状。",
        "evidence": [
          {
            "unit": 3,
            "draft": "正文/0003-把手朝外-final-b.md",
            "sha256": "8439948a84b45466fc68a961df8ecda64d3d976b9c95076096946eccab5bc511",
            "line": 100,
            "quote": "我先问一句。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "后果：9:48许→周实际交箱，50+10×3交沈，借具条注退/还箱下联沈留；箱车绳固定往铺里但未现场写到入铺。",
        "evidence": [
          {
            "unit": 3,
            "draft": "正文/0003-把手朝外-final-b.md",
            "sha256": "8439948a84b45466fc68a961df8ecda64d3d976b9c95076096946eccab5bc511",
            "line": 145,
            "quote": "八十全退，收好了。"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
