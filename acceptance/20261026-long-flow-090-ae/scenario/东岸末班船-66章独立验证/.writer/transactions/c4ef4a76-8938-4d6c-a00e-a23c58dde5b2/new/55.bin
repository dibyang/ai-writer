  "chapter_functions": [
    {
      "unit": 48,
      "goal": {
        "status": "observed",
        "text": "女孩把课堂从母衣反馈转到自己手上新段",
        "evidence": [
          {
            "unit": 48,
            "draft": "正文/0048-自己的那一段-ac-d-v2.md",
            "sha256": "0c1b85ea4f9aa3113adc3dd01d12a3a830fe51f441bf87a15a9766abf2513939",
            "line": 157,
            "quote": "今天想自己走一段"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "线紧起皱/漏里层/手酸与想整晚全做完",
        "evidence": [
          {
            "unit": 48,
            "draft": "正文/0048-自己的那一段-ac-d-v2.md",
            "sha256": "0c1b85ea4f9aa3113adc3dd01d12a3a830fe51f441bf87a15a9766abf2513939",
            "line": 173,
            "quote": "自己两只手将布捏得很平，线却留得短"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "自己退后两针重走、仅完成有限一截并留不齐处",
        "evidence": [
          {
            "unit": 48,
            "draft": "正文/0048-自己的那一段-ac-d-v2.md",
            "sha256": "0c1b85ea4f9aa3113adc3dd01d12a3a830fe51f441bf87a15a9766abf2513939",
            "line": 188,
            "quote": "后面两针怕都得退"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "新段松手不缩、收针归家真实展示，老师未见晚间新反馈；周先认两张后掀底纸另见第三旧细张，一粗两细三张，不逆改31当次裁两张，也没有新购物料。",
        "evidence": [
          {
            "unit": 48,
            "draft": "正文/0048-自己的那一段-ac-d-v2.md",
            "sha256": "0c1b85ea4f9aa3113adc3dd01d12a3a830fe51f441bf87a15a9766abf2513939",
            "line": 319,
            "quote": "新边伏着，那针稍远"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "接受母亲说就这点/放手让自己说明，周也能不携工具出门",
        "evidence": [
          {
            "unit": 48,
            "draft": "正文/0048-自己的那一段-ac-d-v2.md",
            "sha256": "0c1b85ea4f9aa3113adc3dd01d12a3a830fe51f441bf87a15a9766abf2513939",
            "line": 325,
            "quote": "你不是说你会退了么"
          }
        ]
      }
    },
    {
      "unit": 49,
      "goal": {
        "status": "observed",
        "text": "许要为自己听写恢复桌边灯的实际可能，沈要问休息而不被帘先占满。",
        "evidence": [
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 33,
            "quote": "我想试试这盏还能不能留。"
          },
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 434,
            "quote": "我怕一说歇，就只有它等着。"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "旧延期/袋尺寸/店时间/费用未知，父女想要的半日不同；真实班次不是一说半天就批。",
        "evidence": [
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 149,
            "quote": "别等着当场亮给她看。"
          },
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 330,
            "quote": "说你问了。别说我准了。"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "母先电话核/本人实带留看，未为新包装冲动买；沈承认自己想留时间。",
        "evidence": [
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 153,
            "quote": "先告诉自己，自己答了再动。"
          },
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 102,
            "quote": "我还想有一阵这样的。不全留家里等帘干。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "原灯实际从家到店有条，次日午后先问；歇班只得次日午前答复，未先拆帘。",
        "evidence": [
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 218,
            "quote": "位置却真从柜角换到了别人店里。"
          },
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 354,
            "quote": "明天上午认完，午前给她个准话"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "母女共灯已有声音干扰，母真停声让女读；父不被简化成催家务者，坦承叫多也难受。",
        "evidence": [
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 407,
            "quote": "那你先看。我把会的写下，耳朵也歇歇。"
          },
          {
            "unit": 49,
            "draft": "正文/0049-柜角那盏灯-ad-a-v2.md",
            "sha256": "07b42624e104a0d3507c916610e3fe492cd926592bb58c7f9e3302c0a83f3c5f",
            "line": 436,
            "quote": "叫多了，她心里不舒坦，自己嘴里也不舒服。"
          }
        ]
      }
    },
    {
      "unit": 50,
      "goal": {
        "status": "observed",
        "text": "周要从本人返家后的新侧图得知真实用途及谁在场；另实际问灯、批半日、约朋友。",
        "evidence": [
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 5,
            "quote": "想趁上午把前回的照片补一补。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 313,
            "quote": "明日各拿去，看得明白一点。"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "亮照片仍没有柜内部/手怎样碰的完整证据；柜主以为替常用者搬桌是省事。",
        "evidence": [
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 278,
            "quote": "至于她手在里面如何碰到，视频并没有全照到。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 264,
            "quote": "你下午电话里同我说的是叫我回来就搬。"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "周真听常用者/留半桌用途，允许看后不做；陪梁买鞋不代颜色与支付。",
        "evidence": [
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 92,
            "quote": "我能说。你也能说不做。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 153,
            "quote": "周岸给他让开，没有因为自己已经蹲过一回，便等他答那双灰好。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "柜资料推进至周二暂留9—10先看量但地址待发；灯获本店接不了/不收费真实答复，沈周日半日获准。",
        "evidence": [
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 290,
            "quote": "周二九到十先看量，双方在场，地址明日待发。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 217,
            "quote": "本店眼下接不了。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 178,
            "quote": "早上照常，不加早"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "常用者不再被柜主代答；周与梁可有非维修陪伴，而梁自付选鞋。",
        "evidence": [
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 282,
            "quote": "他这回先停，让她把话讲完。"
          },
          {
            "unit": 50,
            "draft": "正文/0050-照片外的一侧-ad-ar-v2.md",
            "sha256": "836a70105be272b8511304ac4ba9aa98a960cbc71054eeed3f5e91108e51a9ab",
            "line": 157,
            "quote": "他拿自己的手机付了钱，没回头等周岸做主。"
          }
        ]
      }
    },
    {
      "unit": 51,
      "goal": {
        "status": "observed",
        "text": "两友真实带各自书坐读，兴趣不必继续服务练衣；母拿回未修灯、父家中自用袋。",
        "evidence": [
          {
            "unit": 51,
            "draft": "正文/0051-翻到自己那页-ad-ar-v1.md",
            "sha256": "ceac81cb3419fe7875f35608df39069d1006f922e3a5faebf0cab719c3fc4bfd",
            "line": 165,
            "quote": "她想问沈禾的，是书里的事，也可以什么都不问。"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "椅/腿/反光影响共读；画里暗角不能认、父也可累不看，未强迫分享。",
        "evidence": [
          {
            "unit": 51,
            "draft": "正文/0051-翻到自己那页-ad-ar-v1.md",
            "sha256": "ceac81cb3419fe7875f35608df39069d1006f922e3a5faebf0cab719c3fc4bfd",
            "line": 266,
            "quote": "这里我看不出来。像布，也可能是别的。"
          },
          {
