        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "母保留先吃与歇，父有周日再看自己饭的决定权",
        "evidence": [
          {
            "unit": 41,
            "draft": "正文/0041-让她自己推一次-ac-b-v1.md",
