  "chapter_functions": [
    {
      "unit": 37,
      "goal": {
        "status": "observed",
        "text": "安置实衣/原纸/练针并提出共同做饭的意愿",
        "evidence": [
          {
            "unit": 37,
            "draft": "正文/0037-各留一道菜-ac-a-v1.md",
            "sha256": "f8d1a97468265b8e1b802524e35679d3369d9c01452d24ecdc7bd6ab17df1739",
            "line": 332,
            "quote": "母亲将衣领递给她，让她接好，自己松手。"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "厨房属于母亲日常空间，班与具体日都未定",
        "evidence": [
          {
            "unit": 37,
            "draft": "正文/0037-各留一道菜-ac-a-v1.md",
            "sha256": "f8d1a97468265b8e1b802524e35679d3369d9c01452d24ecdc7bd6ab17df1739",
            "line": 320,
            "quote": "哪天得先说，我也有我的事"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "先问许可且各做一项，不替母亲答应",
        "evidence": [
          {
            "unit": 37,
            "draft": "正文/0037-各留一道菜-ac-a-v1.md",
            "sha256": "f8d1a97468265b8e1b802524e35679d3369d9c01452d24ecdc7bd6ab17df1739",
            "line": 210,
            "quote": "不如找个都空的半天一起做。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "一次厨房许可成立，原衣实交入袋，门活重约九到十二",
        "evidence": [
          {
            "unit": 37,
            "draft": "正文/0037-各留一道菜-ac-a-v1.md",
            "sha256": "f8d1a97468265b8e1b802524e35679d3369d9c01452d24ecdc7bd6ab17df1739",
            "line": 356,
            "quote": "问过了，厨房可以借一回。各做一点，收好。哪天我们再看班。"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "朋友从各自饭盒走向可合作意愿，母亲保留独立安排",
        "evidence": [
          {
            "unit": 37,
            "draft": "正文/0037-各留一道菜-ac-a-v1.md",
            "sha256": "f8d1a97468265b8e1b802524e35679d3369d9c01452d24ecdc7bd6ab17df1739",
            "line": 320,
            "quote": "我也有我的事"
          }
        ]
      }
    },
    {
      "unit": 38,
      "goal": {
        "status": "observed",
        "text": "把实衣、新条与旧练布真正带到老师灯下",
        "evidence": [
          {
            "unit": 38,
            "draft": "正文/0038-带进灯下-ac-a-v1.md",
            "sha256": "83d9e925e15d28216d579fa569d5b7916b5f58e0cd1789ce8ff5a94c3b3b246d",
            "line": 138,
            "quote": "老师把纸转向灯，读到“三洗后穿”"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "摸见折厚不等于替使用者体验，拉线牵动连续旧针",
        "evidence": [
          {
            "unit": 38,
            "draft": "正文/0038-带进灯下-ac-a-v1.md",
            "sha256": "83d9e925e15d28216d579fa569d5b7916b5f58e0cd1789ce8ff5a94c3b3b246d",
            "line": 152,
            "quote": "她靠桌怎么觉着，还是她说的算。"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "先不拆母衣，自己练四针松第一再两针",
        "evidence": [
          {
            "unit": 38,
            "draft": "正文/0038-带进灯下-ac-a-v1.md",
            "sha256": "83d9e925e15d28216d579fa569d5b7916b5f58e0cd1789ce8ff5a94c3b3b246d",
            "line": 164,
            "quote": "那今天先不拆。我还想把这条边缝明白。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "真实第四课100分钟结束，原物由女带到家门口未交母",
        "evidence": [
          {
            "unit": 38,
            "draft": "正文/0038-带进灯下-ac-a-v1.md",
            "sha256": "83d9e925e15d28216d579fa569d5b7916b5f58e0cd1789ce8ff5a94c3b3b246d",
            "line": 258,
            "quote": "八点四十，老师叫收针"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "老师等学习者自己认线，能保留做得不齐的一小段",
        "evidence": [
          {
            "unit": 38,
            "draft": "正文/0038-带进灯下-ac-a-v1.md",
            "sha256": "83d9e925e15d28216d579fa569d5b7916b5f58e0cd1789ce8ff5a94c3b3b246d",
            "line": 207,
            "quote": "别从布里抓。先认线。"
          }
        ]
      }
    },
    {
      "unit": 39,
      "goal": {
        "status": "observed",
        "text": "将实衣和有限意见还给使用者，使门活到场并付出排班选择",
        "evidence": [
          {
            "unit": 39,
            "draft": "正文/0039-留到手上用-ac-ar-v1.md",
            "sha256": "b6dce9743042ee4365d3bad3b61fb34fa9ef45247aed167417487fd280ce023c",
            "line": 35,
            "quote": "先穿着吧。这两天我换一件，口袋老摸空"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "母仍认角、沈午间交班需代价、门下木况未见",
        "evidence": [
          {
            "unit": 39,
            "draft": "正文/0039-留到手上用-ac-ar-v1.md",
            "sha256": "b6dce9743042ee4365d3bad3b61fb34fa9ef45247aed167417487fd280ce023c",
            "line": 304,
            "quote": "九点刚过，第一根钉还在木头里。"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "母自主先穿；沈愿早半小时争取单方半天；周先商工料",
        "evidence": [
          {
            "unit": 39,
            "draft": "正文/0039-留到手上用-ac-ar-v1.md",
            "sha256": "b6dce9743042ee4365d3bad3b61fb34fa9ef45247aed167417487fd280ce023c",
            "line": 284,
            "quote": "四十工，料你给我看再说。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "原衣真返母、沈获附条件窗口，房门尚未拆修付钱",
        "evidence": [
          {
            "unit": 39,
            "draft": "正文/0039-留到手上用-ac-ar-v1.md",
            "sha256": "b6dce9743042ee4365d3bad3b61fb34fa9ef45247aed167417487fd280ce023c",
            "line": 235,
            "quote": "下周一我早来半小时，十二点半交完能走，你那边怎样？"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "女儿允许母决定不拆；朋友说真愿意和成本，不统一生活",
        "evidence": [
          {
            "unit": 39,
            "draft": "正文/0039-留到手上用-ac-ar-v1.md",
            "sha256": "b6dce9743042ee4365d3bad3b61fb34fa9ef45247aed167417487fd280ce023c",
            "line": 39,
            "quote": "角真叫我难受，我跟你说。今天还没到非拆不可。"
          }
        ]
      }
    },
    {
      "unit": 40,
      "goal": {
        "status": "observed",
        "text": "把待修门条拆清并形成可承担的材料选择",
        "evidence": [
          {
            "unit": 40,
            "draft": "正文/0040-取下来的那一条-ac-b-v1.md",
            "sha256": "34dd63c71e762a2d20c9c3e60e11bae1000e82a59d15a8fca770e8cc2a0b96c7",
            "line": 326,
            "quote": "这一根十块，我付了。"
          }
        ]
      },
      "obstacle": {
        "status": "observed",
        "text": "旧条钉漆相连、地面行程高低不同，老人要留物并挡风",
        "evidence": [
          {
            "unit": 40,
            "draft": "正文/0040-取下来的那一条-ac-b-v1.md",
            "sha256": "34dd63c71e762a2d20c9c3e60e11bae1000e82a59d15a8fca770e8cc2a0b96c7",
            "line": 126,
            "quote": "细的留吧。我不是要把你们关在里头。"
          }
        ]
      },
      "choice": {
        "status": "observed",
        "text": "主人先同意10再由周选直干条，保留细缝不图堵死",
        "evidence": [
          {
            "unit": 40,
            "draft": "正文/0040-取下来的那一条-ac-b-v1.md",
            "sha256": "34dd63c71e762a2d20c9c3e60e11bae1000e82a59d15a8fca770e8cc2a0b96c7",
            "line": 233,
            "quote": "十块就十块，别最后一算又多一样。"
          }
        ]
      },
      "consequence": {
        "status": "observed",
        "text": "周实付10、新条试夹再取下待收；女换周六才得周一窗口",
        "evidence": [
          {
            "unit": 40,
            "draft": "正文/0040-取下来的那一条-ac-b-v1.md",
            "sha256": "34dd63c71e762a2d20c9c3e60e11bae1000e82a59d15a8fca770e8cc2a0b96c7",
            "line": 145,
            "quote": "我能接周六最后两小时。周一十二点，前头做完交给谁？"
          }
        ]
      },
      "relationship_change": {
        "status": "observed",
        "text": "老人能选朝面/余头，沈能提出进门先休息",
        "evidence": [
          {
            "unit": 40,
            "draft": "正文/0040-取下来的那一条-ac-b-v1.md",
            "sha256": "34dd63c71e762a2d20c9c3e60e11bae1000e82a59d15a8fca770e8cc2a0b96c7",
            "line": 212,
            "quote": "那天我到你家，想先坐十分钟喝点水。别我一进门你就把菜递我手里。"
          }
        ]
      }
    },
    {
      "unit": 41,
      "goal": {
        "status": "observed",
        "text": "完成本处固定、让主人分别亲试并实际结账",
