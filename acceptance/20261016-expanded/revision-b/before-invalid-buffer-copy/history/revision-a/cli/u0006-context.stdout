            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 29,
            "quote": "他挑出一个透明塑料盒，将里面那盒原录音带连盒递到她手上。"
          },
          {
            "unit": 4,
            "draft": "正文/0004-先停在这里.md",
            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 57,
            "quote": "沈禾取回原带放入原塑料盒，没有倒带，也没用手拉磁带。"
          },
          {
            "unit": 4,
            "draft": "正文/0004-先停在这里.md",
            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 57,
            "quote": "录音带则收进前层的硬质小袋，不同铁箱混放。"
          }
        ],
        "evidence_omitted": 1
      },
      "T_TAPE": {
        "type": "thread",
        "statement": "原录音带短听仅辨短促钟声、背景低响、麻烦及疑似给字，随后杂音盖住；摩擦异响即停，完整内容声源及与电脑副本关系待核。",
        "truth": null,
        "status": "partial",
        "due_unit": 18,
        "evidence": [
          {
            "unit": 4,
            "draft": "正文/0004-先停在这里.md",
            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 43,
            "quote": "先用自己的试机带检查走带和出声，两边卷轴转动平稳，声音也没有忽快忽慢。"
          },
          {
            "unit": 4,
            "draft": "正文/0004-先停在这里.md",
            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 47,
            "quote": "夹着一声短促钟声。随后有人说话，她只能辨出“麻烦”，隔了一层沙声，又像有一个“给”字"
          },
          {
            "unit": 4,
            "draft": "正文/0004-先停在这里.md",
            "sha256": "c441029c91862cdc9a1b3d8d630854af8fbc6ec1df4a0d5cf3af92458d1429bd",
            "line": 49,
            "quote": "顾遥刚伸手，她已经按了停止。"
          }
        ],
        "evidence_omitted": 1
      },
      "T_INDEX": {
        "type": "thread",
        "statement": "第5章周砚出示自称抄自登记目录的纸，列航务杂存与广播器材两栏，未取得原班表；原目录与材料实际分存待核。",
        "truth": null,
        "status": "pending",
