      "O_PLATE": "初始观察不变：沈第2章独见且未拍抄，周第5章、唐第7章、顾第11章依次获完整口述，至此均未亲见牌。",
      "P_BOX": "两次实际交接保留，仍沈负责店后顶架、编织袋未拆；第11章续付暂放两天至第6日早，落实次日后间看箱半小时但尚未开箱或转管。",
      "P_KEY": "交接罗敬→沈禾发生于修理店，原物封袋保存，跨卷试用尚属未来约束。",
      "T_LAMP": "第13章用原位用法片兑现灯义核对：黄灯两短规定岸端暂停放行，修正船还等着的扩张解释；原口述、due9保留。无年月、无具体亮灯记录，灯未通电；已改变灯柱单列和责任安排，尚待罗核自己口述边界。",
      "P_TAPE": "原带交接与店中短听可见，必须有兼容卡座、可靠走带、清洁干燥与监听，异响需停；尚未全面检查或转录。",
      "O_LAMP_PANEL": "现场实物规定岸端留人暂停放行，不证明船在等、具体年代或哪次实际亮过；沈唐各留工作照，原片未揭随灯原位。",
      "O_INDEX_PAGE": "仅见该页照片，不能代替原目录整册或解释镜头外续页；照片年份是清点登记，不是声音日期。沈收照片，周仍持原抄纸。",
      "O_MAP": "沈第10章亲见许留单张复印纸并拍照；第12章周唐首次看其工作照片，周另收到该照，两人未见原复印纸，图示不证今旧沿革或广播年代。",
      "O_NOTICE": "实见无日期残页，只说明通知文字，不给地点坐标、年代或广播对应。",
      "T_EAST": "第8章现厅六号是寄存编号，不能用来定位旧牌四号泊位；第10章2011复印图将当年候船室和西埠泊位分画，仍无今厅/挂牌/通知年代，部分排除空间混同，旧今沿革和旧四号泊位精确位置仍未证。",
      "T_INDEX": "周第12章出示自称原目录一页的工作照片，沈唐只看照片未亲见原纸；可见2013清理登记器材栏柜喇叭，航务杂存见续页但缺角无号，续页和实际转存仍未知。旧抄件周持。",
      "T_MAP": "已找到许成留存的2011年11月单张维修附图复印件及工作照片；尚无整套原图/确切经手去向，不能给无日期通知或铜牌定年代，不含今厅。",
      "O_DECK": "只证明机器在店试机带条件也会异响，未查出部件原因或排除原带问题；与第4章原带异响不得无证认同唯一原因。",
      "T_TAPE": "原带听辨仍只第4章有限范围。第11章只用店试机带复现卡座干摩擦响，机器断电待查，既不证明当初异响唯一成因，也不证明原带自身完好，尚未再播。",
      "O_CURRENT": "现厅观察不证旧地理；周第8章电话、唐第9章当面分别获沈转述，均未到场亲见。",
      "O_KEY": "形态已见；罗敬提供旧站来处口述，不能凭形状确认用途。"
    },
    "characters": {
      "沈禾": {
        "T_SIGNAL": "从母亲家中硬盘拷未送达目录不满半分钟副本、认母语气；第12章对照纸照仍不能配日期班次，不知剪者与消息给谁/是否接收。第4章原带有限短听仍保留且未证同次，不借纸年补句。",
        "T_HANDOVER": "第4日现场承担灯柱询价后费用、接收责任，先做余筐15:30对单；16:30店内看箱未发生。",
        "O_PLATE": "第2章独自亲见字样右下两线正反无日期、未拍照抄字；第5章告周砚，第7章完整告唐穗，尚未认旧址。",
        "P_BOX": "第11章亲看顶架编织袋口胶带标签未变不取下；清后间桌，续付两天暂放接到第6日早，顾准次日四点半唐看箱半小时；自己到场取放，不转管，不按母亲私物领走。",
        "P_KEY": "受罗敬委托暂存并亲自封袋入包，未试锁；用途不明。",
        "T_LAMP": "原第4章独听罗口述，第9章告唐；第13章亲见并拍门背用法片，现只确认岸端暂停放行，不能推船等或具体年代，未向周罗顾传达新证据。",
        "P_TAPE": "亲接并保存原带，标签只见播字；旧站来处仅听罗敬说；准备后短听、异响停机，不知完整内容。",
        "P_NOTICE": "第12章同场对原通知与工作照片，唐取出且夹回窗边筐，自己未带原页；工作照片仍手机保存。",
        "O_LAMP_PANEL": "亲见用法片及原位并拍两张工作照，知道只约束岸端暂停放行，不证明船等待或哪次使用。",
        "O_INDEX_PAGE": "现场看目录页工作照并收到照片，知道可见页内容和缺角无号，未亲见原纸/续页。",
        "O_MAP": "亲见单张复印图的标题日期候船室与西埠一至六泊位及步行线；亲拍工作照，未找到挂牌或现厅，不能套通知年份。",
        "O_NOTICE": "亲见无日期缺图残通知，第7章拍正面及撕缺边工作照，未将私人号码页入镜；地点与广播关系尚不明。",
        "P_MAP": "原复印纸仍许成收持，自己只带获准拍摄的单张工作照片，未拍邻页老账。",
        "T_EAST": "撤回现箭头直定位法，亲见2011维修复印图候船室与西埠泊位分开有步行线；图无今厅、无挂牌、通知无日期，不能确定旧今沿革或铜牌挂处。",
        "T_INDEX": "第5章见两栏抄纸、第11章电话听照片说法，第12章首次实际看周手机工作照并接收：2013年6月清理登记，器材栏柜喇叭不说明带内容，航务见续页缺角无号；未见原目录纸或续页，转存未知。",
        "T_MAP": "经唐联系后亲到河街，亲见许成取出的2011年11月维修附图复印件并拍单张照片；整套不在许手，许只说施工方收过却无可靠姓名；无日期通知与旧今沿革未明。",
        "O_DECK": "亲手用店试机带复现右侧附近干摩擦响即停，原带没开盒，不认原带已安全。",
        "T_TAPE": "第4章原带有限短听边界保留；第11章仅店试机带查卡座复现异响即停，机器待查，原带仍封盒未检，不能据此证明原带安全或补句。",
        "O_CURRENT": "亲见现六号为寄存及候船登船分开导图，今路牌只能导现厅；不能由此断定旧址或迁移沿革。",
        "O_KEY": "亲见三角磨痕蓝棉绳；听罗敬说清旧站桌时混入工具，未核出处、未认锁。"
      },
      "唐穗": {
        "T_SIGNAL": "第12章首次听沈当面明确母亲家中硬盘未送达目录工作副本、不到半分钟请后断、无日期剪者未知；未试听，知道目录名不证未达、不能认念的就是通知，仍无班次消息接收证据。",
        "T_HANDOVER": "第4日将灯柱单列、答应询价，接收地未定不拆；沈留厅整理以便自己安排木料，当日单15:30未交。",
        "O_PLATE": "第7章首次当面听沈禾完整口述西埠四号泊位、右下两短线、正反无日期、首日独开未拍照抄字；听说昨午已告周砚，原牌仍箱内店后；自己未亲见。",
        "P_BOX": "第11章消息确认次日四点半看箱场地已妥，五点前须走不等额外人；未亲见牌或领回，仍沈负责。",
        "T_LAMP": "第9章获沈转述；第13章亲见用法片且拍照，确认岸端暂停放行，单列灯柱询价未拆。",
        "P_NOTICE": "第12章亲把原通知连硬衬取到干桌供看，后夹回窗边筐继续自己管；号码页另隔白纸，没转交沈周。",
        "O_LAMP_PANEL": "亲见并自己拍原位，知用法片岸端暂停放行，无可辨年月，原片未拆。",
        "O_INDEX_PAGE": "现场看周目录工作照，知道器材清点及见续页缺口，未收到该照或看原纸，不凭灰柜颜色认同物。",
        "O_MAP": "第10章仅消息获述，第12章首次看沈维修图工作照片，知图名年份、候船室外虚线不等当今搬筐路线、无今厅挂牌；未看原复印纸或收到照片。",
        "O_NOTICE": "第6章当场看通知但无印象、称接手已在筐里；第7章看沈禾拍通知，自己留原件，已另获内牌口述但不能据此确认地点。",
        "P_MAP": "第12章只在沈手机看工作照片，知沈称许仍收原复印纸在匣，自己未接纸或照片。",
        "T_EAST": "第9章获沈述现厅；第12章看维修图工作照并问虚线是否搬筐路，沈说不能认，知道图无今厅挂牌，不认旧西埠精确位置。",
        "T_INDEX": "第12章首次亲看周手机目录页工作照，知2013清点器材不等录音内容，续页缺失；未见原目录纸，撤回凭灰柜颜色认物。",
        "T_MAP": "第12章首次看沈手机维修图工作照片，未收到照或见原纸，不能认虚线为今路；许成是否来仅称没见人，图整套去向仍未明。",
        "O_CURRENT": "第9章沈当面说明现六号是寄存、人在厅里等另坐车登船，周仅电话获告，自己未去现厅。"
      },
      "顾遥": {
        "T_SIGNAL": "听沈禾说明不能认定原带与电脑里那段是同一次，未获电脑副本具体来源和日期内容；不知班次及消息去向。",
        "O_PLATE": "第11章首次听沈完整说浅棉布与窄铜牌、西埠四号泊位、右下两短线、正反未找到日期、首日独开未拍抄，封后未再开，周唐仅听说；自己未见牌。",
        "P_BOX": "第11章首次听沈完整内牌口述未亲见，收费空间仍不代管代领不裁归属；收两天续费接至第6日早，准次日四点半后间看箱半小时。",
        "P_KEY": "现场见钥匙交给沈禾封袋，未接手。",
        "P_TAPE": "返店见原带，规格匹配、试机协助、共听后停，未认出声源或完整内容；沈禾保存原物。",
        "O_DECK": "共同查卡座并监听试带，拔电标待查，不再接原带，尚未定位故障部件。",
        "T_TAPE": "第4章共听原带有限范围；第11章只用店试机带监听后复现干摩擦，停机断电，知道机器需查、原带自身仍未查，不认可立即播放。",
        "O_KEY": "看见原钥匙和封袋，主动撤回形状联想；未认定用途。"
      }
    },
