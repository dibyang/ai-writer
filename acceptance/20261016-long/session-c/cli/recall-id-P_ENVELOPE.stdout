        "custody": {
          "holder": "许澄",
          "location": "档案室接待间桌下上锁的干燥抽屉内",
          "condition": "唯一原牛皮封套及原窄纸签，骑缝纸条签名完整，未揭开未复制；已核外封、双方签归还"
        },
        "reader_known": "第5章归还后未再换手；第8章许澄确认封套仍锁接待间干燥抽屉，未再拆。",
        "character_known": {
          "林岚": "第5章见归还许澄，第8章听许澄确认签封封套仍锁干燥抽屉、未再拆。",
          "许澄": "原签封封套仍由自己保管在接待间上锁干燥抽屉，未再拆未复制，向两人确认。",
          "陆衡": "第5章亲手归还许澄，第8章听其确认仍锁干燥抽屉、未再拆；内签仍仅听林岚口述。"
        },
        "evidence": [
          {
            "unit": 2,
            "draft": "正文/0002-封套里面.md",
