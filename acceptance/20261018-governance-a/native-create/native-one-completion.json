  "chapters": [
    {
      "unit": 1,
      "title": "留下那片纸",
      "draft": "正文/0001-留下那片纸.md",
      "body_han": 456,
      "sha256": "73343f61beca2a417bec64d5120d942ea25cd82ba8625994063de32617205264",
      "record_revision": 6,
      "summary": "林小河碰碎旧灯纸后没有直接贴补，保留破片并检查背光处；两处旧纸均酥坏，他选择停工查料，旧灯未点火。",
      "goal": "林小河想在拆灯前找出破口成因",
      "change": "他放弃直接贴补，保留旧纸样并确认背光处也已酥坏"
    },
    {
      "unit": 2,
      "title": "碗底的清水",
      "draft": "正文/0002-碗底的清水.md",
      "body_han": 453,
      "sha256": "11e8b9b54a15983ce8c2fd47fae0c604b75be69b2f773be8692a7300b482e58d",
      "record_revision": 7,
      "summary": "林小河卸除酥纸，在废竹片上试贴新纸，发现自己兑水过多的浆粘不牢；同纸同竹片比较后承认操作问题，留下粘合样并推迟装灯。",
      "goal": "林小河想试出新纸贴牢需要怎样的糨糊",
      "change": "他承认自己为省料兑水过多，放弃硬压灯面，先在废竹片上重做粘合试样"
    },
    {
      "unit": 3,
      "title": "不肯弯的篾",
      "draft": "正文/0003-不肯弯的篾.md",
      "body_han": 469,
      "sha256": "69e6d7b818460a412a561ef8fad7e24bfdd0e316f61952564b854ddbfd6eae1c",
      "record_revision": 8,
      "summary": "林小河发现灯架变形，在拉紧绑线前见到裂缝并停手求证；陶娘承认漏看旧伤，二人换篾后贴好新纸，旧灯置通风架待干，尚未点火。",
      "goal": "林小河想让歪灯架恢复形状",
      "change": "他停止强行收紧绑线，带陶娘查出旧篾裂纹，换掉一段后才开始贴纸"
    },
    {
      "unit": 4,
      "title": "烟从哪里来",
      "draft": "正文/0004-烟从哪里来.md",
      "body_han": 446,
      "sha256": "ef027bc6c610f219ec956cb057d97eeb60f637ef6a45e7d3c6459955f6e3a575",
      "record_revision": 9,
      "summary": "次日干燥与底座检查后，林小河先裸试油盏；因自己挑高灯芯冒烟，先熄火再剪焦端收低灯芯，罩回纸灯照明，收工熄灯并写使用提醒。",
      "goal": "林小河想查验干透纸灯能否稳定照明",
      "change": "他发现自己为了求亮挑高灯芯，熄灯后调整，避免误把黑烟归咎新纸"
    },
    {
      "unit": 5,
      "title": "给用灯的人",
      "draft": "正文/0005-给用灯的人.md",
      "body_han": 454,
      "sha256": "93ce8419696d518258f5d74cf9a05931223f37016791ba20218e0ef053955057",
      "record_revision": 10,
      "summary": "陶娘要借灯补袖口，林小河携熄灭的灯检查东窗台，拒绝窄台加木板方案，清空内侧桌面；他补全维修与使用说明，陶娘复述后等待最终检查，尚未正式接灯。",
      "goal": "林小河想把使用提醒变成别人能照着做的交接说明",
      "change": "他取消只写避风放稳的笼统话，实际检查窗台并选定安全桌位，邀请陶娘按说明复述"
    },
    {
      "unit": 6,
      "title": "灯交出去以后",
      "draft": "正文/0006-灯交出去以后.md",
      "body_han": 471,
      "sha256": "9ee11fad74a906af544abd8310c96b59cf2cbebf69ed61787542f8a7f110e871",
      "record_revision": 11,
      "summary": "林小河独立复核接口、灯芯和底座，说清材料故障与自己的操作失误，并说明使用限制；陶娘正式接灯、看护缝袖后熄灯。林小河分类记录旧样与误判，也记下停手求证。",
      "goal": "林小河想独立完成旧灯复核并把修理责任交代清楚",
      "change": "他不作永不再坏的保证，在说清已修与使用限制后正式交陶娘保管，回看旧样记录自己的误判"
    }
  ],
