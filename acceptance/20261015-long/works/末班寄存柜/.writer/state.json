          "遗留流程",
          "T001"
        ],
        "reader_known": "只获司机回忆与送存过程，周大姐为候选，非排他认主",
        "character_known": {
          "何素琴": "已听并标明口述来源，知道司机没亲见放箱，正在请其找电话",
          "郑来顺": "听到补衣摊线索，只能确认修过周家及别家",
          "何小满": "在场听见司机口述，箱主尚未核实",
          "胡建民": "知道自己送存过程，认得周大姐，未亲见放箱，无现成电话"
        },
        "evidence": [
