        "character_known": {
          "何素琴": "知道原片横幅年份与相合针脚，听到郑的旧修补回忆和转借未知边界",
          "郑来顺": "认得旧照女人周桂枝及自己修过的箱把，但未掌握之后所有流转",
          "何小满": "在场看照片，仍未认领眼前箱"
        },
        "evidence": [
