  "edits": [
    {
      "unit": 16,
      "old": "母亲倒问他鞋盒怎么还没收好。",
      "new": "母亲倒问他盒里的旧鞋带怎么还团着。"
    },
    {
      "unit": 16,
      "old": "今天得把那盒也拿回屋，不能光把布抱走。",
      "new": "今天得把盒里的旧鞋带也拢好，不能光把布抱走。"
    },
    {
      "unit": 16,
      "old": "他先把昨天余下的鞋盒拿回房间，又同母亲说今天把布送到何姐棚下",
      "new": "他先进自己房间，把盒里团着的旧鞋带拢好，扣上盒盖，再出来同母亲说今天把布送到何姐棚下"
    },
    {
      "unit": 17,
      "old": "自己早晨还在收一盒鞋带，拿出来时兴冲冲，叫收回去反而拖到今天",
      "new": "自己出门前才拢好一盒旧鞋带，昨天把盒子拿回房便以为收拾完了，母亲一问才想起里面还团着"
    },
    {
      "unit": 18,
      "old": "自己关好门边留出的空处，请他进来喝水。",
      "new": "自己把门再推开些，请他进来喝水。"
    }
  ],
