    {
      "at": "snapshot.ledger.T_TEST15.evidence",
      "before": [
        {
          "unit": 1,
          "draft": "正文/0001-没有回址.md",
          "sha256": "c313ede3d6bcfea908d632e35420989bae7657b68a7d218a34892df39f383c7a",
          "line": 43,
          "quote": "周六闭馆前，我想知道它还能不能走满一刻钟。"
        },
        {
          "unit": 2,
          "draft": "正文/0002-清点单外.md",
          "sha256": "4c54245ff4feeb08701df503cb9190f8f83b00382b90e22a22b61e2d6ed44d58",
          "line": 17,
          "quote": "他没背下每个字，讲到“先别上弦”时，特意停下来，说这一句他记得清楚。"
        },
        {
          "unit": 3,
          "draft": "正文/0003-先走一刻.md",
          "sha256": "71024dc1bdcc7b8aa3143dbde8c84fb39e315a93f11e5c44fffcaef54459add1",
          "line": 51,
          "quote": "周六上午借您半小时，把它送回阅览室，试走十五分钟。停了就记停了，我不请您签个‘全好’。"
        },
        {
          "unit": 3,
          "draft": "正文/0003-先走一刻.md",
          "sha256": "71024dc1bdcc7b8aa3143dbde8c84fb39e315a93f11e5c44fffcaef54459add1",
          "line": 55,
          "quote": "“九点。过了我要开铺。搬的人你找"
        },
        {
          "unit": 3,
          "draft": "正文/0003-先走一刻.md",
          "sha256": "71024dc1bdcc7b8aa3143dbde8c84fb39e315a93f11e5c44fffcaef54459add1",
          "line": 57,
          "quote": "试完的结果留桌上，寄信的人要回来问，就给他看。"
        },
        {
          "unit": 4,
          "draft": "正文/0004-推车上的钟.md",
          "sha256": "f386c8b96f191708d873fea6700192cd845a7a8582453b4fcc13f69afd815539",
          "line": 71,
          "quote": "手机八点五十八。钟摆垂着，等着师傅最后检查。"
        },
        {
          "unit": 5,
          "draft": "正文/0005-十五分钟以后.md",
          "sha256": "eb92d0cfb234bac1555395eebf8f9a168009e20341dd37ad7d86e886683de223",
          "line": 57,
          "quote": "期间未见停摆，结束时钟面约九点十四分"
        },
        {
          "unit": 5,
          "draft": "正文/0005-十五分钟以后.md",
          "sha256": "eb92d0cfb234bac1555395eebf8f9a168009e20341dd37ad7d86e886683de223",
          "line": 61,
          "quote": "陶芷将原记录压在阅览室桌上的透明垫下面，字朝门口，来问的人伸头就能看。"
        },
        {
          "unit": 6,
          "draft": "正文/0006-留给回来的人.md",
          "sha256": "51e1e733fbf0c7768105444afce179d6c315445c154f35d4f37cd45a6c7b715d",
          "line": 15,
          "quote": "纸放进去以后，她将封套插到柜台里的留言夹，朝他点了点头。"
        },
        {
          "unit": 6,
          "draft": "正文/0006-留给回来的人.md",
          "sha256": "51e1e733fbf0c7768105444afce179d6c315445c154f35d4f37cd45a6c7b715d",
          "line": 57,
          "quote": "原的收这里，之后有人问就翻。林柯那份已经交海堤了。"
        }
      ],
