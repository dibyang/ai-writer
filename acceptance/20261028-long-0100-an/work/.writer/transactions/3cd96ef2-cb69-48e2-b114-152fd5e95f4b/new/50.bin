    "I_REMOTE_RESULT72_116": {
      "type": "fact",
      "statement": "116有限远程试送结果：顾当前消息与截图证初版长名截断点开才分、手机拖17秒过头而从头等到车声；局部找到不等全听/听清缺字或愿付240。沈接受本次结束并只自测修后版。",
      "status": "active",
      "cast": [
        "沈禾",
        "顾遥"
      ],
      "tags": [
        "有限结果",
        "V18"
      ],
      "reader_known": "V17读后选择实质推进V18一次有成本的远程交付及修改；只当次试用完成，质量/定价/商业仍未定。",
      "character_known": {
        "沈禾": "仅见截屏/听顾消息所述，知具体困难和限时；未亲见店内到件、不知道修后外部效果。",
        "顾遥": "亲用本人手机试收初版，自己从头找到车但不承诺长文件整听或付费；不知沈修后具体结果。"
      },
      "evidence": [
        {
          "unit": 116,
          "quote": "顾说自己拿指头找十七秒，往前一点便过头，最后索性从开头等。"
        },
        {
          "unit": 116,
          "quote": "外头得点开才知道，先改这个。"
        },
        {
          "unit": 116,
          "quote": "这个数没有进账，也没被顾判定太贵或便宜。"
        }
      ]
    }
