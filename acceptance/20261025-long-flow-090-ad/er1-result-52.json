  "delta": {
    "body_changed": false,
    "characters": {
      "周岸": "周日台前亲接柜主怕白耗时电话，分清主自己想与常用者亲答，拒无约预付款，先看后现场定做法/费用/愿否，周二9—10不改；收尺未开材料箱，答洗手去吃面，未记实际吃完或到柜。承接48三张一粗两细及可用碎角，本章未见定量耗用或新采购。"
    }
  },
  "quotes": [
    {
      "id": "T_ROUTE_STEP",
      "unit": 52,
      "quote": "“她说等我。那我就走这一边。”她指缓坡。"
    },
    {
      "id": "T_ROUTE_STEP",
      "unit": 52,
      "quote": "粮油店那一头被门面遮着，人转过去，许蓉便看不见了。"
    },
    {
      "id": "P_ROUTE_MASTER",
      "unit": 52,
      "quote": "女人的旧照片和新拍背面都跟着人去了"
    },
    {
      "id": "P_ROUTE_MASTER",
      "unit": 52,
      "quote": "母图夹回簿里，抽屉里的旧信封没有拿出来。"
    },
    {
      "id": "P_ROUTE_MASTER",
      "unit": 52,
      "quote": "许蓉将今日当班页翻到辨图那行"
    },
    {
      "id": "P_ROUTE_MASTER",
      "unit": 52,
      "quote": "他看清位置，没将两张都抽到桌面来重新排，先把钥匙接过去。"
    },
    {
      "id": "F_W_CURTAIN_WASH",
      "unit": 52,
      "quote": "旧幅留在窗上，暗印仍是原来那一点。"
    },
    {
      "id": "F_W_CURTAIN_WASH",
      "unit": 52,
      "quote": "那一点暗印仍留着，帘子只遮到能够遮的地方"
    },
    {
      "id": "P_W_CURTAIN_BAG",
      "unit": 52,
      "quote": "自己伸手取浅蓝袋里的盒，眼镜戴上"
    },
    {
      "id": "P_W_CURTAIN_BAG",
      "unit": 52,
      "quote": "他取下眼镜，收回盒，书由沈禾自己带回床边。"
    },
    {
      "id": "P_W_PICTURE_BOOK",
      "unit": 52,
      "quote": "沈禾把原画册取出来"
    },
    {
      "id": "P_W_PICTURE_BOOK",
      "unit": 52,
      "quote": "她将原白纸留在旧夹处"
    },
    {
      "id": "P_W_PICTURE_BOOK",
      "unit": 52,
      "quote": "找到那页，递给父亲"
    },
    {
      "id": "P_W_PICTURE_BOOK",
      "unit": 52,
      "quote": "书由沈禾自己带回床边。"
    },
    {
      "id": "T_D_CABINET_PHOTOS",
      "unit": 52,
      "quote": "问周二先看过，若最后不做，算不算白耽误师傅。"
    },
    {
      "id": "T_D_CABINET_PHOTOS",
      "unit": 52,
      "quote": "周岸答今天没有同他约这笔钱，不让他先转"
    },
    {
      "id": "T_D_CABINET_PHOTOS",
      "unit": 52,
      "quote": "先看后由两人决定是否继续。"
    },
    {
      "id": "P_DR_FLOWER_BOOK",
      "unit": 52,
      "quote": "找到一张先前不大留意的绿叶。"
    },
    {
      "id": "P_DR_FLOWER_BOOK",
      "unit": 52,
      "quote": "“你先看你的。”她道，“我自己还有这盏。”"
    },
    {
      "id": "P_AC_PRACTICE_CLOTH",
      "unit": 52,
      "quote": "留着一截距离，走了几针"
    },
    {
      "id": "P_AC_PRACTICE_CLOTH",
      "unit": 52,
      "quote": "拆掉自己今天末尾那一小截"
    },
    {
      "id": "P_AC_PRACTICE_CLOTH",
      "unit": 52,
      "quote": "线慢慢退出来，旧排还在别处。"
    },
    {
      "id": "P_AC_PRACTICE_CLOTH",
      "unit": 52,
      "quote": "姑娘过一阵才回，说自己今天做了新的一点收尾，还是硬，没动原排；"
    },
    {
      "id": "P_AD_LYRIC_ENVELOPE",
      "unit": 52,
      "quote": "母亲抄了两行，中间仍留着那两个空"
    },
    {
      "id": "P_AD_LYRIC_ENVELOPE",
      "unit": 52,
      "quote": "信封仍是母亲自己收在床边。"
    },
    {
      "id": "T_AD_SECOND_CURTAIN",
      "unit": 52,
      "quote": "她只把未洗那幅的上沿托起"
    },
    {
      "id": "T_AD_SECOND_CURTAIN",
      "unit": 52,
      "quote": "她用家里的白夹将一幅布分开搭"
    },
    {
      "id": "T_AD_SECOND_CURTAIN",
      "unit": 52,
      "quote": "沈禾答厚边还没干，今晚先留这里。"
    },
    {
      "id": "T_AD_SECOND_CURTAIN",
      "unit": 52,
      "quote": "她坐回来，只说这幅由自己收挂，没干便等"
    },
    {
      "id": "T_AD_DAY_OFF",
      "unit": 52,
      "quote": "今天早上她按平常钟点来的"
    },
    {
      "id": "T_AD_DAY_OFF",
      "unit": 52,
      "quote": "她把围裙解开，挂到不碰湿带的那一边，向老板说自己走了。"
    },
    {
      "id": "T_AD_DAY_OFF",
      "unit": 52,
      "quote": "沈禾看钟，两点出头。"
    },
    {
      "id": "T_AD_DAY_OFF",
      "unit": 52,
      "quote": "两回都坐了，没有因为在店里坐过，便省掉外头那阵。"
    },
    {
      "id": "F_AD_ROUTE_PHOTO_CHECK52",
      "unit": 52,
      "quote": "今日出门前才转过来"
    },
    {
      "id": "F_AD_ROUTE_PHOTO_CHECK52",
      "unit": 52,
      "quote": "这回拍清了“需上台阶”和“推车从缓坡上，沟边慢行”"
    },
    {
      "id": "F_AD_ROUTE_PHOTO_CHECK52",
      "unit": 52,
      "quote": "旧正面仍在上一处，没有删。"
    },
    {
      "id": "P_AD_ROUTE_PHOTOS52",
      "unit": 52,
      "quote": "她把新拍的背面留在手机前头，旧正面仍在上一处，没有删。"
    },
    {
      "id": "P_AD_ROUTE_PHOTOS52",
      "unit": 52,
      "quote": "她给家里发了背面"
    },
    {
      "id": "P_AD_PRACTICE_NOTE52",
      "unit": 52,
      "quote": "又换了另一张小废纸，只写今天自己折边收尾，拆过一回，放手仍有硬点。"
    },
    {
      "id": "P_AD_PRACTICE_NOTE52",
      "unit": 52,
      "quote": "便先把纸和布收回桌内，再取书。"
    },
    {
      "id": "T_AD_LIGHTING_CHOICE",
      "unit": 52,
      "quote": "明天我想看看新的，不提旧的去等人再看。"
    },
    {
      "id": "T_AD_LIGHTING_CHOICE",
      "unit": 52,
      "quote": "“我先去。我白天空，别等到你也下工。”"
    }
  ],
