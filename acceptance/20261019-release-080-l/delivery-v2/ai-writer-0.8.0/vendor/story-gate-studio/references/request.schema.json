{
  "schema_version": "story-gate-request-schema@0.1.0",
  "required_top_level_fields": [
    "request_id",
    "host",
    "mode",
    "task",
    "project_root",
    "rule_pack",
    "write_policy"
  ],
  "optional_top_level_fields": [
    "input_refs",
    "target_refs",
    "project_rule_pack"
  ],
  "allowed_hosts": [
    "codex",
    "container",
    "agent",
    "ci"
  ],
  "allowed_modes": [
    "novel",
    "visual",
    "screenplay",
    "short_drama"
  ],
  "allowed_write_policy": [
    "review_only",
    "create_docs",
    "edit_draft"
  ]
}
