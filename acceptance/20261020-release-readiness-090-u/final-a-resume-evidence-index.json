  "observation": {
    "type": "observation",
    "statement": "箱盖左后角有一块月牙形的白漆。",
    "author_truth": "箱盖左后角确有月牙形白漆；它不是暗号，也不能单独充当排他归属证明。",
    "status": "active",
    "cast": [
      "许蓉",
      "周岸",
      "沈禾",
      "沈成林"
    ],
    "tags": [
      "旧铁箱",
      "白漆"
    ],
    "due_unit": 3,
    "reader_known": "许蓉亲见原句所指白漆；沈父电话给出过滴漆说法，成因未独立核实。",
    "character_known": {
      "许蓉": "亲见左后角月牙形白漆，电话听沈父说记得并给出滴漆解释；未作排他鉴定。",
      "周岸": "见过旧箱并说与梁家旧箱相似；正文未明确他核看过白漆形状位置。",
      "沈禾": "在场听到许蓉询问箱盖白漆，未直接核认该细节形状位置。",
      "沈成林": "电话称记得左后角漆块并给出旧日滴漆说法；未见当前现场原箱。"
    },
