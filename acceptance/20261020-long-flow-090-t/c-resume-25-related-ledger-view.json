          "unit": 3,
          "draft": "正文/0003.md",
          "sha256": "c95951887db5d557a144238483c71d0c412f208842516e84e44368b6f5cc549d",
          "line": 75,
          "quote": "布的中间摸上去已经没有凉意，何岚仍让它挂着"
        },
        {
          "unit": 4,
          "draft": "正文/0004.md",
          "sha256": "6d10e3b0d5ea503b4b46bf5076b99258a62b3832bdcecab9ee9b0645916c197d",
          "line": 157,
          "quote": "将折好的幕布交到许舟怀里。"
        },
        {
          "unit": 4,
          "draft": "正文/0004.md",
          "sha256": "6d10e3b0d5ea503b4b46bf5076b99258a62b3832bdcecab9ee9b0645916c197d",
          "line": 159,
          "quote": "明天午后我拿回来，先挂给你们看。"
        },
        {
          "unit": 5,
          "draft": "正文/0005.md",
          "sha256": "3d9abc901b3e6d59f9f36c6fdb4e0ed962e2e697f1bb7ba6bc01edfcb6ad8b1b",
          "line": 21,
          "quote": "何岚把布收到自己怀里，抱到干净的凳面上。"
        },
        {
          "unit": 6,
          "draft": "正文/0006.md",
          "sha256": "e5e9e30c7526bff3a0b5381f431ef2772866aa2c20b83111e1629113f29a9941",
          "line": 39,
          "quote": "何岚把布袋收进后间柜中。"
        },
        {
          "unit": 8,
          "draft": "正文/0008.md",
          "sha256": "6e33cf5651e15b6f5a6a6d0ec804e7a306adc7a7c29f7a515416af76e33586a9",
          "line": 163,
          "quote": "还在后间柜里，没拿出来。"
        },
        {
          "unit": 8,
          "draft": "正文/0008.md",
          "sha256": "6e33cf5651e15b6f5a6a6d0ec804e7a306adc7a7c29f7a515416af76e33586a9",
          "line": 167,
          "quote": "那一袋布我还收着，要用的时候再说。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 61,
          "quote": "她拢住袋口，等许舟空出双手，才将整袋交给他。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 39,
          "quote": "明天，第十六日下午两点五十五分以前，送回你店里，交到你手上。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 161,
          "quote": "他告辞时，许舟将门打开，布袋在屋里内墙的木箱上，袋口拢好，下面的包纸还平着。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 163,
          "quote": "午后，林照回到住处，收到许舟一条消息，说自己已到铺，布留在家中没有动。"
        },
        {
          "unit": 16,
          "draft": "正文/0016.md",
          "sha256": "6a9bffa29057894f85de13fb6def0888765809a5c1c0d21809c3cc9aa215afe8",
          "line": 109,
          "quote": "布从木箱离开，袋底没拖地，林照手里只有对折的包纸。"
        },
        {
          "unit": 16,
          "draft": "正文/0016.md",
          "sha256": "6a9bffa29057894f85de13fb6def0888765809a5c1c0d21809c3cc9aa215afe8",
          "line": 29,
          "quote": "布到了这里也没算还我，许舟得照昨天的话，收好交我手里。"
        },
        {
          "unit": 16,
          "draft": "正文/0016.md",
          "sha256": "6a9bffa29057894f85de13fb6def0888765809a5c1c0d21809c3cc9aa215afe8",
          "line": 115,
          "quote": "两只夹子夹在完整的边上，小弯离夹口还有一段，布下沿悬着，袋子折好留在垫纸的木板上。"
        },
        {
          "unit": 18,
          "draft": "正文/0018.md",
          "sha256": "50cf63e170447278e2d53f7c71ec213a134a5cea2d78207a65aec9a19918aef3",
          "line": 19,
          "quote": "许舟将袋子往前送，她两手接住底下，他等她说稳了，才松开。"
        },
        {
          "unit": 18,
          "draft": "正文/0018.md",
          "sha256": "50cf63e170447278e2d53f7c71ec213a134a5cea2d78207a65aec9a19918aef3",
          "line": 25,
          "quote": "袋子放在柜中原来收布的那层，旁边的被单被她往里推了少许，袋底平着，口上的绳头收在里侧。"
        },
        {
          "unit": 18,
          "draft": "正文/0018.md",
          "sha256": "50cf63e170447278e2d53f7c71ec213a134a5cea2d78207a65aec9a19918aef3",
          "line": 81,
          "quote": "他说许亲自交到她手上，自己和许在后间门边看着她收进原来那层柜，夹子也收回；许两点五十七自报回铺，没有误那半小时。"
        }
      ],
      "tags": [],
      "introduced_unit": 1,
      "updated_unit": 18,
      "reader_known": "第六晚归柜与十五日新借是两次不同阶段；本次在故事十六日14:53由许在14:55截止前亲交何，何亲收入原层柜，林许见入柜。不是仅带到店就算还，不因归还确认邵用布或旧片全史。",
      "previous_holder": "许舟"
    }
  },
  {
    "id": "O_SHORT_DRAFT",
    "entry": {
      "type": "object",
      "statement": "林照根据陈阿姨第九日有限讲述及周伯送碗补述整理的短抄稿。",
      "status": "active",
      "cast": [
        "林照",
        "周伯",
        "陈阿姨"
      ],
      "tags": [
        "抄稿",
        "署名",
        "可订正"
      ],
      "reader_known": "两份同文清稿仍各人自存、可改撤，14本人在可纠正的有限朗读许可已在16日实际使用；本次只念后屋段，周本人另说送碗。口误未改原字，稿未散发拍摄，不含旧信/新捎信记忆。",
      "character_known": {
        "林照": "本次只带自存清稿念后收回，十六日末回住处实际归夹前层、与私抄信/旧改稿分放，不换周份；其他人未因此新知自己的住处放置。",
        "周伯": "现场听本次后屋段、自己另说送碗，确认家中原字稿不必替换，自己份仍抽屉。",
        "陈阿姨": "十六日本人在场亲听本次后屋段、纠正口误并明确不必改纸，仍未持纸或准散发。",
        "许舟": "十五日未听全文的历史保留；十六日首次完整听本次后屋段及周亲说送碗、陈纠正，未看持清稿、未听私抄信或14捎信收窄。",
        "何岚": "十六日在侧门内第一次完整听本次后屋段及周本人送碗，听陈纠正，不持纸或获散稿/旧信许可。"
      },
      "custody": {
        "holder": "林照、周伯各一份",
        "location": "周原清稿仍家中桌边抽屉独立袋；林自存清稿已从包内薄袋回住处纸夹前层、收干处",
        "condition": "本次有限朗读完毕，原字仍雨小，未散发拍摄、没有新改字或换稿；两份自存可改撤的许可不扩大"
      },
      "evidence": [
        {
          "unit": 11,
          "draft": "正文/0011.md",
          "sha256": "97ed21ea76d9bea17f8558fc5de3d25c5efe64e2c1a8fd3d72236a7230199f80",
          "line": 123,
          "quote": "他用买来的胶带补好自己的纸夹，将改过的稿与新稿分开放，原来那页现场笔记仍夹在本子里。"
        },
        {
          "unit": 11,
          "draft": "正文/0011.md",
          "sha256": "97ed21ea76d9bea17f8558fc5de3d25c5efe64e2c1a8fd3d72236a7230199f80",
          "line": 125,
          "quote": "抄清的纸暂时没有交到谁手上。"
        },
        {
          "unit": 12,
          "draft": "正文/0012.md",
          "sha256": "57fa55b36d603c6dfed34005caa7be902e2c27fa65064bcfec9f38b4499139c7",
          "line": 52,
          "quote": "自己那张收回纸夹，原清稿交到周伯手里。"
        },
        {
          "unit": 12,
          "draft": "正文/0012.md",
          "sha256": "57fa55b36d603c6dfed34005caa7be902e2c27fa65064bcfec9f38b4499139c7",
          "line": 52,
          "quote": "周伯取来一只空文件袋，将它装进去，放进桌边抽屉，没有同原节目单混在一起。"
        },
        {
          "unit": 13,
          "draft": "正文/0013.md",
          "sha256": "84f8a57da060f7fcb7c48e9a69c833b93c4214acf220b261eacea4d06a5eeded",
          "line": 281,
          "quote": "上层装节目单的文件袋没有抽出，桌边存清稿的抽屉也没有打开。"
        },
        {
          "unit": 14,
          "draft": "正文/0014.md",
          "sha256": "6e242b479d7131791b9301b2c096426c0a7178313fbd2bd5d03bfaef09baaa57",
          "line": 29,
          "quote": "我在旁边的时候，你可以念。哪句念岔，我还能叫住你。别说是替邵师傅交代什么，他后来去了哪儿，我不知道。"
        },
        {
          "unit": 14,
          "draft": "正文/0014.md",
          "sha256": "6e242b479d7131791b9301b2c096426c0a7178313fbd2bd5d03bfaef09baaa57",
          "line": 135,
          "quote": "纸夹依旧合着，何岚没看里面的两页，听见的只有他当面带到的那些话。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 113,
          "quote": "昨天陈阿姨答应的是她在旁边能纠正时，念先前核过的后屋那点。周伯送碗归他自己补述。信不放进去，纸不发给人。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 115,
          "quote": "我没听过那张短稿。到时候别让我替她接后半句。"
        },
        {
          "unit": 15,
          "draft": "正文/0015.md",
          "sha256": "0ad181c20d868b6e0c58b1ffaeb334e54b52af8d7128bde903552d13bc3e6656",
          "line": 163,
          "quote": "前层清稿没有添字，后层的私人信摘抄和电话记页也没抽出来另用。"
        },
        {
          "unit": 16,
          "draft": "正文/0016.md",
          "sha256": "6a9bffa29057894f85de13fb6def0888765809a5c1c0d21809c3cc9aa215afe8",
          "line": 80,
          "quote": "他只取纸夹前层的清稿，装进一个干净薄袋。"
        },
        {
          "unit": 16,
          "draft": "正文/0016.md",
          "sha256": "6a9bffa29057894f85de13fb6def0888765809a5c1c0d21809c3cc9aa215afe8",
          "line": 119,
          "quote": "林照取回自己的包，打开薄袋，把清稿平托在手上。"
        },
        {
          "unit": 17,
          "draft": "正文/0017.md",
          "sha256": "d4b0aa57e856a10bfbd40234c9aeaab8f753e1cf67dd406193ff5ab58054d362",
          "line": 107,
          "quote": "纸上的字别因为今天口里念错，又给它改一遍。"
        },
        {
          "unit": 17,
          "draft": "正文/0017.md",
          "sha256": "d4b0aa57e856a10bfbd40234c9aeaab8f753e1cf67dd406193ff5ab58054d362",
          "line": 111,
          "quote": "周伯在旁边应了一声，说自己那份还在家里，不要晚上又来敲门换一张。"
        },
        {
          "unit": 17,
          "draft": "正文/0017.md",
          "sha256": "d4b0aa57e856a10bfbd40234c9aeaab8f753e1cf67dd406193ff5ab58054d362",
          "line": 111,
          "quote": "他把薄袋放回自己的包，扣好包口，没留下那张纸让空着的凳子压住。"
        },
        {
          "unit": 18,
          "draft": "正文/0018.md",
          "sha256": "50cf63e170447278e2d53f7c71ec213a134a5cea2d78207a65aec9a19918aef3",
          "line": 95,
          "quote": "回住处，他把小凳放回桌边，取出薄袋，将清稿放回纸夹前层。"
        }
      ],
      "introduced_unit": 11,
      "updated_unit": 18,
      "previous_holder": "林照、周伯各一份"
    }
  }
]
