  "authority_journal": {
    "schema_version": 1,
    "patch": [
      {
        "at": [
          "characters",
          "沈禾"
        ],
        "had": true,
        "has": true,
        "before": "第2日下午旧站窗下整理散页；铜牌原观察首次当面完整告知周砚，唐穗顾遥罗敬仍未获告。原箱未搬未拆仍顾遥店后，钥匙与原带仍背包原分袋；灯语未核、短听边界未变。看过周砚所示目录抄件，未亲见目录原件；暂猜广播也许涉及西埠去船，先查旧地名。已履约帮唐穗，不外发私人号码页。",
        "after": "第2日傍晚顾遥店；铜牌原观察已告周砚，唐穗顾遥罗敬仍不知。下午已履约整理和交单，发现无日期改候船通知；初猜今客运码头可能接续旧西埠位置并发周砚，尚未去现场。取消次日修音台面、未接城里急活；原箱顶架封装未拆，原带与钥匙随身分袋未动，灯语未核、短听范围未增。"
      },
      {
        "at": [
          "characters",
          "周砚"
        ],
        "had": true,
        "has": true,
        "before": "第2日午后旧站树下赴约后回新渡口；保留第1章副本所知，首次听沈禾完整口述铜牌字样、右下两线、正反无日期及未拍照抄字，在所持抄件背面注明沈禾述；未亲见铜牌。出示自抄目录两栏，原班表未取得；未获告灯语、钥匙或原带。",
        "after": "第2日值班；保留副本所知和第5章沈禾口述全部铜牌信息，未亲见牌；所持目录抄件与沈禾述仍保留。第6章消息获知无日期残页及今客运码头可能接续西埠的猜想，只回避入作业区；未亲见残页，未获告灯语钥匙原带。"
      },
      {
        "at": [
          "characters",
          "唐穗"
        ],
        "had": true,
        "has": true,
        "before": "第2日下午旧站；已交回封箱、知道顾遥店暂放处及号码，仍未见也未获告铜牌内容；沈禾如约帮整理，提醒含私人号码的散页不外发并共同托放。",
        "after": "第2日五点半前旧站收工；与沈禾同见通知残页、对过留存位置，仍未见铜牌或获告内容；原箱仍按已知顾遥店位置，不接回。约沈禾明早九点半前说准是否回来，自己将带人搬西架。"
      },
      {
        "at": [
          "characters",
          "顾遥"
        ],
        "had": true,
        "has": true,
        "before": "第2日上午末店中；先处理客户原样确认、借小扇给罗敬，收沈禾工时后协助卡座试机、短听与停机；只辨钟声背景与残字，不知地点及带子与电脑副本关系；未听到罗敬路上灯语，仍未见铜牌也未受托原箱保管。",
        "after": "第2日傍晚店中处理客户旧冰箱；沈禾帮照明挪机器，提前取消次日台面，他已转给客户。原箱只收费提供空间不代管，仍不知内牌；原钥匙见证与失约拒答、原带短听所知保留，不知灯语；当日未重播原带。"
      },
      {
        "at": [
          "timeline"
        ],
        "append": [
          "第2日下午四点后：旧站同见西埠线改候船通知残页，夹硬衬与其他未辨年代页留窗边筐；沈禾放弃搭车追查，和唐穗完成当日留存单，五点半前收工。",
          "第2日傍晚：沈禾沿堤二十分钟回店，途中蓝箭头使她形成地点接续猜想并发周砚；提前取消次日台面、未接城里急活，确认原箱及分袋物件未动，原带不重播。"
        ],
        "length": 9
      },
      {
        "at": [
          "ledger",
          "T_HANDOVER",
          "character_known",
          "沈禾"
        ],
        "had": true,
        "has": true,
        "before": "亲见第7日移交通知，承担每日清单并已退票；第2日下午实际回来帮唐穗，含私人号码页夹白纸与相邻页保留，未外发。",
        "after": "亲见第7日移交通知、退票并承担每日留存单；第2日下午守约帮整理，未外发号码页，已完成当日交单和位置核对；约明早九点半前说准是否回来。"
      },
      {
        "at": [
          "ledger",
          "T_HANDOVER",
          "character_known",
          "唐穗"
        ],
        "had": true,
        "has": true,
        "before": "向沈禾说明期限并给桌、要求每日清单；第2日下午与沈禾共同整理，提醒私人号码页不外发。",
        "after": "保留第7日移交和每日清单责任；第2日与沈禾实际整理并核单，约明早九点半前说准回来时间，自己带人搬西架。"
      },
