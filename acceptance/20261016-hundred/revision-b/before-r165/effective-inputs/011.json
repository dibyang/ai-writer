  "authority_journal": {
    "schema_version": 1,
    "patch": [
      {
        "at": [
          "characters",
          "沈禾"
        ],
        "had": true,
        "has": true,
        "before": "第3日四点零五河街铺外；亲见许成留存2011年11月维修附图复印件并获准拍单张工作照片，图中候船室与西埠泊位有步行通道；不含现厅，通知无日期，旧今沿革未明。原复印纸仍许持，唐仅消息知见图与缺口，周尚未告。原箱店后未动，钥匙和原带分袋随包未取用；未向许报内牌字刻线或问成灯语。",
        "after": "第3日傍晚顾店门前，电话后取包拟买炒面；原钥匙内侧封袋、原带前层硬袋未动，箱仍店后顶架封装未拆。只向顾说明浅布窄铜牌、归属未核及自己负责，未报铭文刻线日期，清后间小桌、续费至第6日早，落实第4日四点半唐来看箱不接管；未另邀周占唐时间。与顾只用店试机带见卡座异响，原带自身未查。电话获周称拍到目录一页尚未见，约次早九点十分旧站半小时；灯语和主线仍未证。"
      },
      {
        "at": [
          "characters",
          "周砚"
        ],
        "had": true,
        "has": true,
        "before": "第3日仅电话参与，未到客运厅。仍持第5章两栏抄件和沈禾述铜牌笔记；铜牌仅转述无亲见。第6章消息获残通知及地点猜想，第8章电话获沈禾所见六号寄存、候船厅另接驳和找旧图建议；自己未见此现场、原通知或图，称未见过旧图。未获告钥匙原带灯语，原副本班次仍不明。",
        "after": "第3日仅电话，仍持两栏抄纸，自称今日拍到目录其中一页尚未向沈出示；约第4日九点十分到旧站，九点四十须走。仅听沈述许成留2011维修复印纸、沈带照片、图分候船室泊位且无现厅不定通知年代，未看图或亲到河街。第5章内牌仍口述未见，未获原带钥匙灯语。"
      },
      {
        "at": [
          "characters",
          "唐穗"
        ],
        "had": true,
        "has": true,
        "before": "第3日旧站；收沈消息称看到2011维修复印图、原纸许留、沈拍工作照，图无现厅通知仍无年份，并听许拟次日看漏水的转述；自己未见图，回称窗筐盖好。第9章现厅与灯语仅转述所知、铜牌仅第7章全口述和第4日看箱约保留，未接箱或获原带钥匙细节。",
        "after": "第3日旧站消息接收沈已问妥顾店后间、次日四点半当面看箱不领回；强调五点前回家做饭不等额外人，尚未到店见牌。原通知仍自己管；现厅和灯语来自沈第9章转述、维修图仅第10章消息范围，不知原带钥匙。"
      },
      {
        "at": [
          "characters",
          "顾遥"
        ],
        "had": true,
        "has": true,
        "before": "第2日傍晚店中处理客户旧冰箱；沈禾帮照明挪机器，提前取消次日台面，他已转给客户。原箱只收费提供空间不代管，仍不知内牌；原钥匙见证与失约拒答、原带短听所知保留，不知灯语；当日未重播原带。",
        "after": "第3日店内，客户优先后只听沈说箱内浅布窄铜牌、归属未核且仍由沈负责；尚不知铭文刻线和日期信息，未亲见；不替归属担责或代领。收两天续费接至第6日早，准第4日四点半后间看箱半小时并收费；与沈只用店试机带复现卡座干摩擦响，停机断电标待查，未检查或重播原带。既有钥匙交接见证、罗失约拒答及原短听所知保留，不知灯语。"
      },
      {
        "at": [
          "timeline"
        ],
        "append": [
          "第3日四点零五后：沈禾从河街步行二十一分钟，四点二十六回顾店，等客户取冰箱后仅告顾箱内有浅布窄铜牌、归属未核及沈负责，未报牌面；整理后间桌、续费至第6日早，消息落实次日四点半看箱。",
          "第3日五点一刻起：收费半小时只用店试机带查卡座，数分钟复现干摩擦响即停，拔电标待查；原带仍原盒硬袋，未重播。",
          "第3日傍晚：沈店门外电话向周述维修图边界，周称拍到目录一页未展示；约第4日九点十分旧站，九点四十离开，沈取包拟买炒面。"
        ],
        "length": 20
      },
