  "authority_journal": {
    "schema_version": 1,
    "patch": [
      {
        "at": [
          "characters",
          "沈禾"
        ],
        "had": true,
        "has": true,
        "before": "第1日傍晚在顾遥店；独自知道铜牌字样刻线无日期，没拍照抄写或告人；知道箱已交唐穗小库锁存，约翌日九点前领取；对旧地名有联想但未认定现有码头；因迟到答应明早帮顾遥干到期活。",
        "after": "第2日上午顾遥店；保管未拆封原铁箱及包内原铜钥匙，铜牌知情边界不变；听罗敬承认私人失约并尊重拒答；接受收费和客户优先，约午后与周砚查目录、下午回站帮唐穗。"
      },
      {
        "at": [
          "characters",
          "周砚"
        ],
        "had": true,
        "has": true,
        "before": "已回新渡口；亲听工作副本，知道原盘在沈禾家、文件缺日期；不认可据此配班；承诺先查登记目录，未取得结果。",
        "after": "新渡口，通过消息答午后查目录并问沈禾是否吃早饭；延续第1章已听工作副本的知识，尚未拿到目录结果，仍未获铜牌内容。"
      },
      {
        "at": [
          "characters",
          "唐穗"
        ],
        "had": true,
        "has": true,
        "before": "锁存沈禾封装的原铁箱于旧站小库高层木架；没在开箱现场，未见铜牌未获其内容，要求翌晨领走腾电料位置。",
        "after": "第2日上午旧站收电料；实际交回封好的原铁箱，知道暂放顾遥店及联系方式；仍未见铜牌且未获告其内容；与沈禾约下午整理散页。"
      },
      {
        "at": [
          "characters",
          "顾遥"
        ],
        "had": true,
        "has": true,
        "before": "第1日傍晚送货；只知沈禾迟到、要明早占两小时并带早饭；没有看铁箱或铜牌。",
        "after": "修理店；出租干燥顶架、保留客户优先，没接箱保管责任也没开箱；现场见蓝棉绳铜钥匙交沈禾，听到罗敬拒谈私因；钥匙没试锁。"
      },
      {
        "at": [
          "characters",
          "罗敬"
        ],
        "had": false,
        "has": true,
        "after": "修理店等待电扇试转；亲口承认对沈岚一次未补上的失约，拒答私因；自工具袋交原铜钥匙给沈禾暂存，称清旧站桌时混入工具，具体锁不明；说家中另存一件声音物品尚未取出。"
      },
      {
        "at": [
          "timeline"
        ],
        "append": [
          "第2日八点至上午：沈禾与顾遥约定收费暂放及客户优先；八点四十从唐穗实际领回原封铁箱，搬到顾遥店后隔间顶架，第二次交接唐穗→沈禾。",
          "第2日上午：罗敬在修理店拒答私人失约原因，另将原铜钥匙交沈禾；沈禾分袋装包，未试锁。"
        ],
        "length": 3
      },
