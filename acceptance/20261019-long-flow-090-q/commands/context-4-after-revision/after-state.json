  "snapshot": {
    "characters": {
      "林照": "在何岚店，接受有限一场而非连办多晚；持原节目单，约周伯明日下午核字。",
      "何岚": "在小店，拒绝替林照连续多晚出力；同意按实际再定一晚，并留周伯伸腿的位置。；经林照当面告知，已知周伯第四日下午来店核字。",
      "许舟": "本章未到店，仍未接幕布，也未获三格说明。",
      "周伯": "电话中答应第四日下午四点前后来店核纸；原片仍在自己家。"
    },
    "threads": [],
    "timeline": [
      "第一晚：借场、搬货、晾布；周伯借出节目单，约白天再核。",
      "第二日下午：看布未干，登门尊重原片借用限制；许舟用自带棉布试针。",
      "第三日下午：实看渡口候船亭，保留候船用途；筹备改为先办一晚，借到两张凳子，约次日核字。"
    ],
